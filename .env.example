# Copy to .env and fill in. .env is gitignored.

# GitHub. If unset, the ingest falls back to `gh auth token`.
GITHUB_TOKEN=

# Target repository for ingest.
TARGET_REPO_OWNER=pandas-dev
TARGET_REPO_NAME=pandas

# Where raw GitHub JSON is staged before it goes to S3.
RAW_DATA_DIR=data/raw

# AWS / S3. Not required to run the ingest.
AWS_REGION=us-east-1
S3_RAW_BUCKET=

# CockroachDB. Not required to run the ingest.
COCKROACH_DSN=

# LLM, used for rule extraction.
ANTHROPIC_API_KEY=

# Embeddings. Anthropic has no embeddings API, so this is a separate provider.
# text-embedding-3-small is 1536 wide, which is what migration 0001 declares.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
